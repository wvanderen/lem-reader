#!/bin/bash
# Factory driver-plane consumer (issue #277). Invoked by the
# lemcentre-factory.path unit when an envelope lands in the spool
# (/var/lib/lem-ci/factory-jobs). Runs OUTSIDE the hardened runner unit —
# the runner unit's namespace hardening breaks the harness's reviewed
# bwrap sandbox — inside lemcentre-factory.service, whose property set
# {NoNewPrivileges, ProtectHome, PrivateTmp, UMask} is the largest set
# verified not to (5/5 deterministic during #277 debugging).
#
# Security shape:
# - Runs as the same unprivileged `lemci` account; executes only
#   /usr/local/libexec/factory-ci/factory-validate-inner (root-owned,
#   pin-enforced) with strictly validated envelope fields.
# - Envelope fields are validated fail-closed: head must be a full 40-hex
#   SHA, checkout must resolve inside the runner's own work folder, id
#   must be bounded hex. Anything else is refused with a failed result.
# - A hostile PR can enqueue garbage (same uid owns the spool) but only
#   ever causes validations of runner-work checkouts — code that runs in
#   the disposable guest anyway. Queue overflow fails closed (visible
#   red verdicts), never silently drops.
set -euo pipefail

JOBS="/var/lib/lem-ci/factory-jobs"
INNER="/usr/local/libexec/factory-ci/factory-validate-inner"
FLEET="/opt/factory/lemfleet"
ENVELOPE="$FLEET/proof/f4a/envelope.py"
EVIDENCE_ROOT="/var/lib/lem-ci/factory-ci/evidence"
# Stale-claim bound (issue #283). Must satisfy, together with the sweep
# timer's OnUnitInactiveSec + AccuracySec (lemcentre-factory-sweep.timer):
#   STALE_SECONDS + timer + accuracy <= DEADLINE_SECONDS - POLL_SECONDS
# (factory-validate's constants), so a crashed claim is swept to its
# fail-closed verdict while the waiting wrapper is still polling — instead
# of the wrapper expiring first (exit 5) and the claim lingering. The
# pairing record is ops/lemcentre-runner/recovery-constants.json; #279/#280
# must re-satisfy it if they adjust the job time bounds. (Supersedes the
# interim 5580 s pairing from #279, which swept at the wrapper's whole-wait
# deadline and could only agree with an already-surfaced failure; 4500 s
# sweeps strictly inside it. The pre-#279 7200 s bound was worse still — a
# 24-minute window where a dead job was "concluded" for nobody.
# lem-reader#279/#283, lemfleet#22/#24, ADR-0013.)
STALE_SECONDS=4500
MAX_JOBS_PER_RUN=6

mkdir -p "$JOBS"

# Orphan sidecars: an artifacts sidecar whose result is gone and whose
# claim is gone belonged to a wrapper that died between consuming the
# verdict and the diagnostics — dispose it; diagnostics never outlive
# their job's conclusion.
for orphan in "$JOBS"/*.artifacts; do
  [ -e "$orphan" ] || break
  id="$(basename "$orphan" .artifacts)"
  if [ ! -e "$JOBS/$id.result" ] && [ ! -e "$JOBS/$id.running" ]; then
    rm -f "$orphan"
    echo "driver-process: disposed orphan artifacts sidecar $id" >&2
  fi
done

# Sweep stale interrupted claims: a previous driver invocation that died
# mid-job leaves <id>.running; older than the stale bound, it becomes a
# failed result so the waiting wrapper sees a fail-closed verdict instead
# of hanging out its deadline. (Runner-side crashes kill the whole service
# cgroup — INNER and its QEMU guest die with it — so only files survive;
# the sweep timer guarantees this loop runs even with no new spool write.)
# Any artifacts sidecar for the same id is disposed with it: diagnostics
# for a swept job never outlive the job's own fail-closed conclusion.
for running in "$JOBS"/*.running; do
  [ -e "$running" ] || break
  if [ "$(( $(date +%s) - $(stat -c %Y "$running") ))" -gt "$STALE_SECONDS" ]; then
    id="$(basename "$running" .running)"
    printf '{"exit": 3}\n' > "$JOBS/$id.result"
    rm -f "$running" "$JOBS/$id.artifacts" "$JOBS/$id.artifacts.tmp"
    echo "driver-process: stale claim $id failed closed (exit 3)" >&2
  fi
done

mapfile -t spooled < <(ls "$JOBS"/*.job 2>/dev/null | sort)
if [ "${#spooled[@]}" -gt "$MAX_JOBS_PER_RUN" ]; then
  # Overflow fails closed NOW with a visible red verdict instead of being
  # deferred: the spool watch is PathModified (edge-triggered), so leftover
  # .job envelopes are consumed only if something else writes to the spool —
  # otherwise their wrappers hang out the full 93-minute deadline. An
  # envelope that lands between the listing and this sweep is failed, not
  # lost; its gate re-runs.
  for job in "${spooled[@]:$MAX_JOBS_PER_RUN}"; do
    id="$(basename "$job" .job)"
    printf '{"exit": 3}\n' > "$JOBS/$id.result.tmp"
    mv "$JOBS/$id.result.tmp" "$JOBS/$id.result"
    rm -f "$job"
    echo "driver-process: queue overflow; envelope $id failed closed (exit 3)" >&2
  done
fi
queue=("${spooled[@]:0:$MAX_JOBS_PER_RUN}")

for job in "${queue[@]}"; do
  id="$(basename "$job" .job)"
  running="$JOBS/$id.running"
  mv "$job" "$running"

  verdict=3
  validated="$(python3 -B - "$running" <<'PYEOF'
import json, re, sys

try:
    envelope = json.loads(open(sys.argv[1]).read())
except Exception:
    print("MALFORMED")
    sys.exit(0)

ident = envelope.get("id", "")
head = envelope.get("head", "")
checkout = envelope.get("checkout", "")
diagnostics = envelope.get("diagnostics", False)
ok_id = re.fullmatch(r"[0-9a-f]{32}", ident)
ok_head = re.fullmatch(r"[0-9a-f]{40}", head)
ok_diag = diagnostics is True  # absent (legacy) or exactly true; nothing else
try:
    real = __import__("os").path.realpath(checkout)
    ok_checkout = real.startswith("/var/lib/lem-ci/runner-work/")
except Exception:
    ok_checkout = False
print("DIAGNOSTICS" if ok_id and ok_head and ok_checkout and ok_diag else
      ("OK" if ok_id and ok_head and ok_checkout else "MALFORMED"))
PYEOF
)"

  if [ "$validated" != "OK" ] && [ "$validated" != "DIAGNOSTICS" ]; then
    echo "driver-process: refused malformed envelope $id" >&2
  else
    head="$(python3 -B -c 'import json,sys; print(json.load(open(sys.argv[1]))["head"])' "$running")"
    checkout="$(python3 -B -c 'import json,sys; print(json.load(open(sys.argv[1]))["checkout"])' "$running")"
    inner_args=("$head" "$checkout")
    if [ "$validated" = "DIAGNOSTICS" ]; then
      inner_args+=("--diagnostics" "--artifact-sink" "$JOBS/$id.artifacts")
    fi
    if "$INNER" "${inner_args[@]}"; then
      verdict=0
    else
      verdict=$?
    fi
    # The artifacts sidecar is validated the same fail-closed way the
    # verdict is: strict schema, paths inside the factory evidence root,
    # digest/bytes proven against the actual files (lemfleet envelope.py).
    # A refused sidecar never changes the verdict — the artifact channel
    # must not be able to mask or forge a test result (lem-reader#279).
    if [ "$validated" = "DIAGNOSTICS" ] && [ -e "$JOBS/$id.artifacts" ]; then
      if ! python3 -B "$ENVELOPE" validate-sidecar "$JOBS/$id.artifacts" "$EVIDENCE_ROOT" >/dev/null 2>&1; then
        echo "driver-process: artifacts sidecar for $id failed validation; dropping diagnostics (verdict unchanged)" >&2
        rm -f "$JOBS/$id.artifacts"
      fi
    fi
  fi

  printf '{"exit": %d}\n' "$verdict" > "$JOBS/$id.result.tmp"
  mv "$JOBS/$id.result.tmp" "$JOBS/$id.result"
  rm -f "$running"
done

exit 0
