# Candidate profile for lemfleet#20. It replaces, never supplements, the
# legacy driver unit. Do not install or start without the reviewed handoff.
[Unit]
Description=Lemcentre isolated validation driver (reviewed harness only)

[Service]
Type=oneshot
User=lemvalidator
Group=lemvalidator
SupplementaryGroups=lemci lem-heavy kvm
WorkingDirectory=/var/lib/lem-v
ExecStart=/usr/bin/python3 -IB /usr/local/libexec/factory-ci/isolated-spool.py serve
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
PrivateTmp=yes
InaccessiblePaths=-/var/lib/lem-ci
# Filesystem confinement (lemfleet#20): the whole tree is read-only to the
# driver except its private scratch. The pinned harness checkout is read
# only; guests, caches, claims and replies live under /var/lib/lem-v.
ProtectSystem=strict
ReadWritePaths=/var/lib/lem-v
# Address families the driver needs: loopback proxy + git/npm egress (INET,
# INET6), the QEMU socket channel (UNIX). Nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Deliberately NOT set here: MemoryDenyWriteExecute (breaks V8 JIT),
# SystemCallFilter (unreviewed for QEMU/node), IPAddressDeny (registry egress
# is allowlisted by the preparation boundary's proxy, not by IP),
# ProcSubset/ProtectProc (lease guard reads /proc/loadavg).
UMask=0077
