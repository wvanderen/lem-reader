    "title": "HTML: Creating the content",
    "author": "MDN contributors",
    "retrievedAt": "2026-07-28T15:35:00Z",
    "originalHtmlHash": "23004d76a40f6ed39c2eba18690ced5a9876c26103f87280fbc03683cf5284c6",
