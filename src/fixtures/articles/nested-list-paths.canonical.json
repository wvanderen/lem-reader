    "title": "Nested list structures",
    "author": "MDN Contributors",
    "retrievedAt": "2026-08-30T00:00:00Z",
    "originalHtmlHash": "7c1e4a9f0b3d2856e1fa9c04b7d2e8f13a6c5b09d4e7f2a8c1b3d5e9f0a2c4d6e",
