.vercel/
.vercel

# Vercel function bundle — GENERATED by `npm run build:api` (esbuild) from
# api-src/ingest.ts; rebuilt during every deploy's buildCommand, never
# committed (debug session vercel-ingest-500: per-file @vercel/node
# transpile cannot resolve extensionless relative ESM imports)
/api/
